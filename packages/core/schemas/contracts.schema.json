        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "$ref": "#/$defs/HostTarget"
        },
        "controls": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 256
            },
            "dials": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 256
            }
          },
          "required": [
            "keys",
            "dials"
          ],
          "additionalProperties": false
