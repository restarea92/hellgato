{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hellgato.dev/schemas/contracts-v1.json",
  "title": "Hellgato device contracts v1",
  "description": "Canonical serialized SDK contracts. Structural schema plus runtime semantic checks bound pixels, bytes, references, and mapping compatibility.",
  "version": 1,
  "$defs": {
    "Capability": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "native",
            "emulated",
            "unsupported",
            "unverified"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "maxItems": 32
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "DisplaySurface": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "format": {
          "enum": [
            "jpeg",
            "rgb888"
          ]
        },
        "partial": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "width",
        "height",
        "format",
        "partial"
      ],
      "additionalProperties": false
    },
    "DeviceCapabilities": {
      "type": "object",
      "properties": {
        "keys": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "touch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          ]
        },
        "displays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisplaySurface"
          },
          "maxItems": 256
        },
        "dialPress": {
          "enum": [
            "native",
            "pulse",
            "unsupported",
            "unverified"
          ]
        },
        "dialRelease": {
          "enum": [
            "native",
            "unavailable",
            "unverified"
          ]
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Capability"
          },
          "maxProperties": 64
        }
      },
      "required": [
        "keys",
        "dials",
        "touch",
        "displays",
        "dialPress",
        "dialRelease"
      ],
      "additionalProperties": false
    },
    "AdapterDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 64
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 32
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 32
        },
        "apiVersion": {
          "const": 1
        },
        "protocol": {
          "type": "object",
          "properties": {
            "major": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "version",
        "modelIds",
        "platforms",
        "architectures",
        "apiVersion"
      ],
      "additionalProperties": false
    },
    "DeviceDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "firmware": {
          "type": "string",
          "maxLength": 256
        },
        "capabilities": {
          "$ref": "#/$defs/DeviceCapabilities"
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "adapterId",
        "modelId",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "keyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "keyWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "keyHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "encoderCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "touchWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "touchHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "rows",
        "columns",
        "keyCount",
        "keyWidth",
        "keyHeight",
        "encoderCount",
        "touchWidth",
        "touchHeight",
        "productName"
      ],
      "additionalProperties": false
    },
    "DeviceConfig": {
      "type": "object",
      "properties": {
        "serialNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "childSerialNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "dockFirmwareVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "childFirmwareVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "productId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
