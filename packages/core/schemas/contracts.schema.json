                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 64
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "touch": {
          "type": "object",
          "properties": {
            "rotation": {
              "enum": [
                0,
                90,
                180,
                270
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "displays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "id",
        "version",
        "target",
        "controls",
        "requirements"
      ],
      "additionalProperties": false
    },
    "InputEvent": {
      "oneOf": [
        {
          "type": "object",
