            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "const": "key"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "state": {
              "enum": [
