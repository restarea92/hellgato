    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restarea92/hellgato.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/restarea92/hellgato/issues",
  "homepage": "https://github.com/restarea92/hellgato#readme",
