{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/restarea92/hellgato/blob/main/.release/plan.schema.json",
  "title": "Reviewed Hellgato release intent, generated only by release-version.mjs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "baseSha",
    "bootstrap",
    "changesets",
    "components",
    "generatedFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "const": "restarea92/hellgato"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "bootstrap": {
      "type": "boolean"
    },
    "changesets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "content",
          "releases",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          },
          "content": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "releases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "@hellgato/core",
                    "hellgato",
                    "@hellgato/windows-release"
                  ]
                },
                "type": {
                  "enum": [
                    "patch",
                    "minor",
                    "major"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "oldVersion",
          "version",
          "channel",
          "tag",
          "notes"
        ],
        "properties": {
          "component": {
            "enum": [
              "windows",
              "npm"
            ]
          },
          "oldVersion": {
            "anyOf": [
              {
                "$ref": "#/$defs/version"
              },
              {
                "const": "0.0.1-beta"
              }
            ]
          },
          "version": {
            "$ref": "#/$defs/version"
          },
          "channel": {
            "const": "stable"
          },
          "tag": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "pattern": "^docs/releases/[a-z0-9.-]+\\.md$"
          },
          "packages": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "oldVersion",
                "version",
                "tag"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "@hellgato/core",
                    "hellgato"
                  ]
                },
                "oldVersion": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/version"
                    },
                    {
                      "const": "0.0.1-beta"
                    }
                  ]
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "tag": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "generatedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
